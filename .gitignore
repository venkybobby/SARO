# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/

# Testing
.pytest_cache/
.coverage
coverage.xml
coverage.json
htmlcov/
.tox/

# Environment files — never commit secrets
.env
.env.*
!.env.example

# Claude Code — local machine settings only
.claude/settings.local.json
.claude/transcripts/
**/.claude/transcripts/
# Agent worktrees — local, transient; never committed (registered ones are
# already git-ignored, this also covers deregistered/orphaned leftovers)
.claude/worktrees/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Railway / Docker
.railway/

# Node (scripts tooling)
node_modules/
scripts/node_modules/

# Demo screen-capture kit — live browser sessions (AWS/Supabase/frontend cookies)
# and unreviewed screenshots must never be committed.
demo-capture/profiles/
demo-capture/shots/

# Synthetic Bedrock log fixtures (local scratch, regenerable) and local MCP
# plugin cache — not app state, never intended for commit.
/demo-logs/
/demo-logs-a/
/demo-logs-b/
.claude/data/

# Continuous-learning hook output (session-local, advisory)
.claude/learnings/

# E2E/demo run outputs (screenshots regenerated per run)
/artifacts/
.local-sqlite-demo.db
